  local interpolationDuration = 0.5
  helper.setCurrentSlide(deck40, 1)
  openspace.setPropertyValueSingle("ScreenSpace.deck40_de_energy_credits1.Enabled", false)
  openspace.setPropertyValueSingle("ScreenSpace.deck40_de_energy_credits1.Opacity", 1.0)
end)

