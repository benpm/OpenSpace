-- Create a position for other files to share
--
-- Version by Ka Chun Yu (DMNS) May 2024
local earth = asset.require('scene/solarsystem/planets/earth/globe') --include earth
local derby_dome_wy_pump_jack_position = {
  Identifier = "derby_dome_wy_pump_jack_position",
  Parent = earth.Earth.Identifier,
  Transform = {
      Translation = {
        Type = "GlobeTranslation",
        Globe = earth.Earth.Identifier,
        -- LATITUDE and LONGITUDE should be in degrees:
        Latitude = 42.691910,
        Longitude = -108.555570,
        UseHeightmap = true,
        -- Set ALTITUDE in meters so that it's above the landscape:
        Altitude = 50.00
      },
      Scale = {
        Type = "StaticScale",
        Scale = 1.0
      },
      Rotation = {
        Type = "StaticRotation",
        Rotation = {0.00,0.00,0.00}
      }
  },
  GUI = {
    Name = "Derby Dome WY Pump Jack Position",
    Path = "/DMNS/Z_Pano_Positions/Derby Dome WY Pump Jack",
    Hidden = true
  }
}


asset.onInitialize(function()
  openspace.addSceneGraphNode(derby_dome_wy_pump_jack_position)
end)
asset.onDeinitialize(function()
  openspace.removeSceneGraphNode(derby_dome_wy_pump_jack_position)
end)
asset.export(derby_dome_wy_pump_jack_position)
