-- Create a position for other files to share
--
-- Version by Ka Chun Yu (DMNS) May 2024
local earth = asset.require('scene/solarsystem/planets/earth/globe') --include earth
local tristate_erie_substation_pano_5_position = {
  Identifier = "tristate_erie_substation_pano_5_position",
  Parent = earth.Earth.Identifier,
  Transform = {
      Translation = {
        Type = "GlobeTranslation",
        Globe = earth.Earth.Identifier,
        -- LATITUDE and LONGITUDE should be in degrees:
        Latitude = 40.0268250000,
        Longitude = -104.9559861111,
        UseHeightmap = true,
        -- Set ALTITUDE in meters so that it's above the landscape:
        Altitude = 50.00
      },
      Scale = {
        Type = "StaticScale",
        Scale = 1.0
      },
      Rotation = {
        Type = "StaticRotation",
        Rotation = {0.00,0.00,0.00}
      }
  },
  GUI = {
    Name = "Tri-State Erie Substation Pano 5 Position",
    Path = "/DMNS/Z_Pano_Positions/Tri-State Erie Substation Pano 5",
    Hidden = true
  }
}


asset.onInitialize(function()
  openspace.addSceneGraphNode(tristate_erie_substation_pano_5_position)
end)
asset.onDeinitialize(function()
  openspace.removeSceneGraphNode(tristate_erie_substation_pano_5_position)
end)
asset.export(tristate_erie_substation_pano_5_position)
