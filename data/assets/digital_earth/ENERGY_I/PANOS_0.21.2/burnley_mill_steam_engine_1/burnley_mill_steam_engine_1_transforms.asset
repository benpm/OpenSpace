-- Create a position for other files to share
--
-- Version by Ka Chun Yu (DMNS) May 2024
local earth = asset.require('scene/solarsystem/planets/earth/globe') --include earth
local burnley_mill_steam_engine_1_position = {
  Identifier = "burnley_mill_steam_engine_1_position",
  Parent = earth.Earth.Identifier,
  Transform = {
      Translation = {
        Type = "GlobeTranslation",
        Globe = earth.Earth.Identifier,
        -- LATITUDE and LONGITUDE should be in degrees:
        Latitude = 51.497366666667,
        Longitude = -0.174486111111,
        UseHeightmap = true,
        -- Set ALTITUDE in meters so that it's above the landscape:
        Altitude = 50.00
      },
      Scale = {
        Type = "StaticScale",
        Scale = 1.0
      },
      Rotation = {
        Type = "StaticRotation",
        Rotation = {0.00,0.00,0.00}
      }
  },
  GUI = {
    Name = "Burnley Mill Steam Engine 1 Position",
    Path = "/DMNS/Z_Pano_Positions/Burnley Mill Steam Engine 1",
    Hidden = true
  }
}


asset.onInitialize(function()
  openspace.addSceneGraphNode(burnley_mill_steam_engine_1_position)
end)
asset.onDeinitialize(function()
  openspace.removeSceneGraphNode(burnley_mill_steam_engine_1_position)
end)
asset.export(burnley_mill_steam_engine_1_position)
