-- Actions for the "12. Oil Drilling Songs (11:34): Roughneck / This Old Rig / I'm a Tool Pusher From Snyder / Ashland Oil / Ballad of Jedd Clampett" card of the Digital Earth Energy I show.
-- Generated from data/de_energy_0.21.html; these appear in the in-app
-- Actions panel under "/Digital Earth/13 Oil Drilling Songs".

local actions = {
  {
    Identifier = "de.energy.songs_oil.play_from_start",
    Name = "Play from START",
    Command = [[
      openspace.audio.stopAudio("OilDrillingSongsVideo")
      openspace.audio.playAudio("${ASSETS}/digital_earth/ENERGY_I/VIDEOS/cash.roughneck_frank.this.old.rig_willet.im.a.tool.pusher.from.snyder_ashland.oil_flatt.scruggs.ballad.of.jedd.clampett.mp3", "OilDrillingSongsVideo", false)
    ]],
    Documentation = "Play from START (12. Oil Drilling Songs (11:34): Roughneck / This Old Rig / I'm a Tool Pusher From Snyder / Ashland Oil / Ballad of Jedd Clampett)",
    GuiPath = "/Digital Earth/13 Oil Drilling Songs",
    Color = { 0.85, 0.85, 0.2, 1.0 },
    IsLocal = false
  },
  {
    Identifier = "de.energy.songs_oil.pause",
    Name = "Pause",
    Command = [[
      openspace.audio.pauseAudio("OilDrillingSongsVideo")
    ]],
    Documentation = "Pause (12. Oil Drilling Songs (11:34): Roughneck / This Old Rig / I'm a Tool Pusher From Snyder / Ashland Oil / Ballad of Jedd Clampett)",
    GuiPath = "/Digital Earth/13 Oil Drilling Songs",
    IsLocal = false
  },
  {
    Identifier = "de.energy.songs_oil.resume",
    Name = "Resume",
    Command = [[
      openspace.audio.resumeAudio("OilDrillingSongsVideo")
    ]],
    Documentation = "Resume (12. Oil Drilling Songs (11:34): Roughneck / This Old Rig / I'm a Tool Pusher From Snyder / Ashland Oil / Ballad of Jedd Clampett)",
    GuiPath = "/Digital Earth/13 Oil Drilling Songs",
    IsLocal = false
  },
  {
    Identifier = "de.energy.songs_oil.loop_on",
    Name = "LOOP ON",
    Command = [[
      openspace.audio.setLooping("OilDrillingSongsVideo", true)
    ]],
    Documentation = "LOOP ON (12. Oil Drilling Songs (11:34): Roughneck / This Old Rig / I'm a Tool Pusher From Snyder / Ashland Oil / Ballad of Jedd Clampett)",
    GuiPath = "/Digital Earth/13 Oil Drilling Songs",
    Color = { 0.85, 0.85, 0.2, 1.0 },
    IsLocal = false
  },
  {
    Identifier = "de.energy.songs_oil.loop_off",
    Name = "LOOP OFF",
    Command = [[
      openspace.audio.setLooping("OilDrillingSongsVideo", false)
    ]],
    Documentation = "LOOP OFF (12. Oil Drilling Songs (11:34): Roughneck / This Old Rig / I'm a Tool Pusher From Snyder / Ashland Oil / Ballad of Jedd Clampett)",
    GuiPath = "/Digital Earth/13 Oil Drilling Songs",
    Color = { 0.8, 0.25, 0.25, 1.0 },
    IsLocal = false
  },
  {
    Identifier = "de.energy.songs_oil.stop",
    Name = "STOP",
    Command = [[
      openspace.audio.stopAudio("OilDrillingSongsVideo")
    ]],
    Documentation = "STOP (12. Oil Drilling Songs (11:34): Roughneck / This Old Rig / I'm a Tool Pusher From Snyder / Ashland Oil / Ballad of Jedd Clampett)",
    GuiPath = "/Digital Earth/13 Oil Drilling Songs",
    Color = { 0.8, 0.25, 0.25, 1.0 },
    IsLocal = false
  },
}

asset.onInitialize(function()
  for _, a in ipairs(actions) do
    openspace.action.registerAction(a)
  end
end)

asset.onDeinitialize(function()
  for _, a in ipairs(actions) do
    openspace.action.removeAction(a.Identifier)
  end
end)

asset.meta = {
  Name = "Digital Earth Energy I Actions - 12. Oil Drilling Songs (11:34): Roughneck / This Old Rig / I'm a Tool Pusher From Snyder / Ashland Oil / Ballad of Jedd Clampett",
