asset.onInitialize(function()
  for _, a in ipairs(actions) do
    openspace.action.registerAction(a)
  end
end)

asset.onDeinitialize(function()
  for _, a in ipairs(actions) do
    openspace.action.removeAction(a.Identifier)
  end
end)

asset.meta = {
  Name = "Digital Earth Energy I Actions - 9. Electricity Supply & Demand Slides",
  Description = "In-app action buttons for the 9. Electricity Supply & Demand Slides section of the Energy I show",
