-- Actions for the "11. Black Marble / Thanks / Credits" card of the Digital Earth Energy I show.
-- Generated from data/de_energy_0.21.html; these appear in the in-app
-- Actions panel under "/Digital Earth/12 Black Marble and Credits".

local actions = {
  {
    Identifier = "de.energy.credits.2012_enhanced_toggle",
    Name = "2012 Enhanced TOGGLE",
    Command = [[
      openspace.toggleFade("Scene.blackMarbleEnhanced2012.Renderable", 1)
    ]],
    Documentation = "2012 Enhanced TOGGLE (11. Black Marble / Thanks / Credits)",
    GuiPath = "/Digital Earth/12 Black Marble and Credits",
    Color = { 0.85, 0.85, 0.2, 1.0 },
    IsLocal = false
  },
  {
    Identifier = "de.energy.credits.40_credits_toggle",
    Name = "40. Credits TOGGLE",
    Command = [[
      openspace.toggleFade("ScreenSpace.deck40_de_energy_credits1",1)
    ]],
    Documentation = "40. Credits TOGGLE (11. Black Marble / Thanks / Credits)",
    GuiPath = "/Digital Earth/12 Black Marble and Credits",
    Color = { 0.85, 0.85, 0.2, 1.0 },
    IsLocal = false
  },
}

asset.onInitialize(function()
  for _, a in ipairs(actions) do
    openspace.action.registerAction(a)
  end
end)

asset.onDeinitialize(function()
  for _, a in ipairs(actions) do
    openspace.action.removeAction(a.Identifier)
  end
end)

asset.meta = {
  Name = "Digital Earth Energy I Actions - 11. Black Marble / Thanks / Credits",
  Description = "In-app action buttons for the 11. Black Marble / Thanks / Credits section of the Energy I show",
  Author = "Digital Earth / DMNS",
  URL = "https://openspaceproject.com",
  License = "MIT license"
}
