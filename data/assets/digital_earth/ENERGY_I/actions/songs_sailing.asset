-- Actions for the "0. Paul Clayton Songs (5:57): The Mermaid / Saturday Night At Sea / The Greenland Whale Fisheries" card of the Digital Earth Energy I show.
-- Generated from data/de_energy_0.21.html; these appear in the in-app
-- Actions panel under "/Digital Earth/01 Sailing Songs".

local actions = {
  {
    Identifier = "de.energy.songs_sailing.play_from_start",
    Name = "Play from START",
    Command = [[
      openspace.audio.stopAudio("SailingSongsVideo")
      openspace.audio.playAudio("${ASSETS}/digital_earth/ENERGY_I/VIDEOS/paul.clayton_the.mermaid_saturday.night.at.sea_the.greenland.whale.fisheries.mp3", "SailingSongsVideo", false)
    ]],
    Documentation = "Play from START (0. Paul Clayton Songs (5:57): The Mermaid / Saturday Night At Sea / The Greenland Whale Fisheries)",
    GuiPath = "/Digital Earth/01 Sailing Songs",
    Color = { 0.85, 0.85, 0.2, 1.0 },
    IsLocal = false
  },
  {
    Identifier = "de.energy.songs_sailing.pause",
    Name = "Pause",
    Command = [[
      openspace.audio.pauseAudio("SailingSongsVideo")
    ]],
    Documentation = "Pause (0. Paul Clayton Songs (5:57): The Mermaid / Saturday Night At Sea / The Greenland Whale Fisheries)",
    GuiPath = "/Digital Earth/01 Sailing Songs",
    IsLocal = false
  },
  {
    Identifier = "de.energy.songs_sailing.resume",
    Name = "Resume",
    Command = [[
      openspace.audio.resumeAudio("SailingSongsVideo")
    ]],
    Documentation = "Resume (0. Paul Clayton Songs (5:57): The Mermaid / Saturday Night At Sea / The Greenland Whale Fisheries)",
    GuiPath = "/Digital Earth/01 Sailing Songs",
    IsLocal = false
  },
  {
    Identifier = "de.energy.songs_sailing.loop_on",
    Name = "LOOP ON",
    Command = [[
      openspace.audio.setLooping("SailingSongsVideo", true)
    ]],
    Documentation = "LOOP ON (0. Paul Clayton Songs (5:57): The Mermaid / Saturday Night At Sea / The Greenland Whale Fisheries)",
    GuiPath = "/Digital Earth/01 Sailing Songs",
    Color = { 0.85, 0.85, 0.2, 1.0 },
    IsLocal = false
  },
  {
    Identifier = "de.energy.songs_sailing.loop_off",
    Name = "LOOP OFF",
    Command = [[
      openspace.audio.setLooping("SailingSongsVideo", false)
    ]],
    Documentation = "LOOP OFF (0. Paul Clayton Songs (5:57): The Mermaid / Saturday Night At Sea / The Greenland Whale Fisheries)",
    GuiPath = "/Digital Earth/01 Sailing Songs",
    Color = { 0.8, 0.25, 0.25, 1.0 },
    IsLocal = false
  },
  {
    Identifier = "de.energy.songs_sailing.stop",
    Name = "STOP",
    Command = [[
      openspace.audio.stopAudio("SailingSongsVideo")
    ]],
    Documentation = "STOP (0. Paul Clayton Songs (5:57): The Mermaid / Saturday Night At Sea / The Greenland Whale Fisheries)",
    GuiPath = "/Digital Earth/01 Sailing Songs",
    Color = { 0.8, 0.25, 0.25, 1.0 },
    IsLocal = false
  },
}

asset.onInitialize(function()
  for _, a in ipairs(actions) do
    openspace.action.registerAction(a)
  end
end)

asset.onDeinitialize(function()
  for _, a in ipairs(actions) do
    openspace.action.removeAction(a.Identifier)
  end
end)

asset.meta = {
  Name = "Digital Earth Energy I Actions - 0. Paul Clayton Songs (5:57): The Mermaid / Saturday Night At Sea / The Greenland Whale Fisheries",
  Description = "In-app action buttons for the 0. Paul Clayton Songs (5:57): The Mermaid / Saturday Night At Sea / The Greenland Whale Fisheries section of the Energy I show",
  Author = "Digital Earth / DMNS",
  URL = "https://openspaceproject.com",
  License = "MIT license"
}
