-- Actions for the "2. 1835 Whaling Voyages Global Animation" card of the Digital Earth Energy I show.
-- Generated from data/de_energy_0.21.html; these appear in the in-app
-- Actions panel under "/Digital Earth/03 Whaling Voyages".

local actions = {
  {
    Identifier = "de.energy.whaling.atmos_toggle",
    Name = "ATMOS TOGGLE",
    Command = [[
      openspace.toggleFade("Scene.EarthAtmosphere.Renderable",1)
    ]],
    Documentation = "ATMOS TOGGLE (2. 1835 Whaling Voyages Global Animation)",
    GuiPath = "/Digital Earth/03 Whaling Voyages",
    IsLocal = false
  },
  {
    Identifier = "de.energy.whaling.shading_toggle",
    Name = "SHADING TOGGLE",
    Command = [[
      local shading = openspace.propertyValue("Scene.Earth.Renderable.PerformShading")
      if shading then
        openspace.setPropertyValue("Scene.Earth.Renderable.PerformShading", false)
        openspace.fadeOut(
          "Scene.Earth.Renderable.Layers.NightLayers.Earth_at_Night_2012",
          nil,
          'openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.NightLayers.Earth_at_Night_2012.Enabled", false)'
        )
      else
        openspace.setPropertyValue("Scene.Earth.Renderable.PerformShading", true)
        openspace.fadeIn("Scene.Earth.Renderable.Layers.NightLayers.Earth_at_Night_2012")
      end
    ]],
    Documentation = "SHADING TOGGLE (2. 1835 Whaling Voyages Global Animation)",
    GuiPath = "/Digital Earth/03 Whaling Voyages",
    IsLocal = false
  },
  {
    Identifier = "de.energy.whaling.whaling_ports_toggle",
    Name = "Whaling Ports TOGGLE",
    Command = [[
      openspace.toggleFade("Scene.WhalingPortNantucketMASeal.Renderable",1)
      openspace.toggleFade("Scene.WhalingPortNewBedfordMASeal.Renderable",1)
      openspace.toggleFade("Scene.WhalingPortNewLondonCTSeal.Renderable",1)
      openspace.toggleFade("Scene.WhalingPortProvincetownMASeal.Renderable",1)
      openspace.toggleFade("Scene.WhalingPortSagHarborNYSeal.Renderable",1)
      openspace.toggleFade("Scene.WhalingPortSanFranciscoCASeal.Renderable",1)
    ]],
    Documentation = "Whaling Ports TOGGLE (2. 1835 Whaling Voyages Global Animation)",
    GuiPath = "/Digital Earth/03 Whaling Voyages",
    IsLocal = false
  },
  {
    Identifier = "de.energy.whaling.american_whaling_voyages_on",
    Name = "American Whaling Voyages ON",
    Command = [[
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.ColorLayers.WhalingVoyagesAOL.Enabled", true)
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.ColorLayers.WhalingVoyagesAOL.Fade",1,1)
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.NightLayers.Earth_at_Night_2012.Enabled", false)
      openspace.setPropertyValueSingle("Scene.EarthAtmosphere.Renderable.Enabled", false)
    ]],
    Documentation = "American Whaling Voyages ON (2. 1835 Whaling Voyages Global Animation)",
    GuiPath = "/Digital Earth/03 Whaling Voyages",
    IsLocal = false
  },
  {
    Identifier = "de.energy.whaling.play",
    Name = "Play",
    Command = [[
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.ColorLayers.WhalingVoyagesAOL.TileProvider.VideoPlayer.Play", nil)
    ]],
    Documentation = "Play (2. 1835 Whaling Voyages Global Animation)",
    GuiPath = "/Digital Earth/03 Whaling Voyages",
    IsLocal = false
  },
  {
    Identifier = "de.energy.whaling.pause",
    Name = "Pause",
    Command = [[
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.ColorLayers.WhalingVoyagesAOL.TileProvider.VideoPlayer.Pause", nil)
    ]],
    Documentation = "Pause (2. 1835 Whaling Voyages Global Animation)",
    GuiPath = "/Digital Earth/03 Whaling Voyages",
    IsLocal = false
  },
  {
    Identifier = "de.energy.whaling.go_to_start",
    Name = "Go to Start",
    Command = [[
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.ColorLayers.WhalingVoyagesAOL.TileProvider.VideoPlayer.GoToStart", nil)
    ]],
    Documentation = "Go to Start (2. 1835 Whaling Voyages Global Animation)",
    GuiPath = "/Digital Earth/03 Whaling Voyages",
    IsLocal = false
  },
  {
    Identifier = "de.energy.whaling.loop_on",
    Name = "LOOP ON",
    Command = [[
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.ColorLayers.WhalingVoyagesAOL.TileProvider.VideoPlayer.LoopVideo", true)
    ]],
    Documentation = "LOOP ON (2. 1835 Whaling Voyages Global Animation)",
    GuiPath = "/Digital Earth/03 Whaling Voyages",
    Color = { 0.85, 0.85, 0.2, 1.0 },
    IsLocal = false
  },
  {
    Identifier = "de.energy.whaling.loop_off",
    Name = "LOOP OFF",
    Command = [[
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.ColorLayers.WhalingVoyagesAOL.TileProvider.VideoPlayer.LoopVideo", false)
    ]],
    Documentation = "LOOP OFF (2. 1835 Whaling Voyages Global Animation)",
    GuiPath = "/Digital Earth/03 Whaling Voyages",
    Color = { 0.8, 0.25, 0.25, 1.0 },
    IsLocal = false
  },
  {
    Identifier = "de.energy.whaling.american_whaling_voyages_off",
    Name = "American Whaling Voyages OFF",
    Command = [[
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.ColorLayers.WhalingVoyagesAOL.Fade",0,1)
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.ColorLayers.WhalingVoyagesAOL.Enabled", false)
      openspace.setPropertyValueSingle("Scene.Earth.Renderable.Layers.NightLayers.Earth_at_Night_2012.Enabled", true)
      openspace.setPropertyValueSingle("Scene.EarthAtmosphere.Renderable.Enabled", true)
    ]],
    Documentation = "American Whaling Voyages OFF (2. 1835 Whaling Voyages Global Animation)",
    GuiPath = "/Digital Earth/03 Whaling Voyages",
    Color = { 0.8, 0.25, 0.25, 1.0 },
    IsLocal = false
  },
}

asset.onInitialize(function()
  for _, a in ipairs(actions) do
    openspace.action.registerAction(a)
  end
end)

asset.onDeinitialize(function()
  for _, a in ipairs(actions) do
    openspace.action.removeAction(a.Identifier)
  end
end)

asset.meta = {
  Name = "Digital Earth Energy I Actions - 2. 1835 Whaling Voyages Global Animation",
  Description = "In-app action buttons for the 2. 1835 Whaling Voyages Global Animation section of the Energy I show",
  Author = "Digital Earth / DMNS",
  URL = "https://openspaceproject.com",
  License = "MIT license"
}
