local ShowSeals = {
  Identifier = "os.BAT.ShowSeals",
  Name = "Show BAT landing labels",
  Command = [[openspace.setPropertyValue("Scene.BAT*.Renderable.Opacity", 1, 0.5)]],
  Documentation = "Show CO BAT seals.",
  GuiPath = "/DMNS/CO Energy",
  IsLocal = false
}

local HideSeals = {
  Identifier = "os.BAT.HideSeals",
  Name = "Hide BAT landing labels",
  Command = [[openspace.setPropertyValue("Scene.BAT*.Renderable.Opacity", 0, 0.5)]],
  Documentation = "Hide CO BAT seals",
  GuiPath = "/DMNS/CO Energy",
  IsLocal = false
}

asset.onInitialize(function()
  openspace.addSceneGraphNode(BAT390_NeptuneEnergyCenterLLC_NeptuneEnergyCenterHybrid_Pueblo)
  openspace.addSceneGraphNode(BAT394_ThunderWolfEnergyCenterLLC_ThunderWolfEnergyCenterHybrid_Pueblo)
  openspace.addSceneGraphNode(BAT459_UnitedPowerInc_RattlesnakeRidgeBatteryStorage_Weld)
  openspace.addSceneGraphNode(BAT463_UnitedPowerInc_DavisBatteryStorage_Weld)
  openspace.addSceneGraphNode(BAT464_UnitedPowerInc_BromleyBatteryStorage_Adams)
  openspace.addSceneGraphNode(BAT465_UnitedPowerInc_KeenesburgBatteryStorage_Weld)
  openspace.addSceneGraphNode(BAT467_AESCleanEnergy_HighMesaCO_Garfield)
  openspace.addSceneGraphNode(BAT480_WhetstonePowerOperationsLLC_PrairieCenterEnergyLLC_Adams)
  openspace.action.registerAction(ShowSeals)
  openspace.action.registerAction(HideSeals)
end)


asset.onDeinitialize(function()
  openspace.action.removeAction(HideSeals)
  openspace.action.removeAction(ShowSeals)
  openspace.removeSceneGraphNode(BAT390_NeptuneEnergyCenterLLC_NeptuneEnergyCenterHybrid_Pueblo)
  openspace.removeSceneGraphNode(BAT394_ThunderWolfEnergyCenterLLC_ThunderWolfEnergyCenterHybrid_Pueblo)
  openspace.removeSceneGraphNode(BAT459_UnitedPowerInc_RattlesnakeRidgeBatteryStorage_Weld)
  openspace.removeSceneGraphNode(BAT463_UnitedPowerInc_DavisBatteryStorage_Weld)
  openspace.removeSceneGraphNode(BAT464_UnitedPowerInc_BromleyBatteryStorage_Adams)
  openspace.removeSceneGraphNode(BAT465_UnitedPowerInc_KeenesburgBatteryStorage_Weld)
  openspace.removeSceneGraphNode(BAT467_AESCleanEnergy_HighMesaCO_Garfield)
  openspace.removeSceneGraphNode(BAT480_WhetstonePowerOperationsLLC_PrairieCenterEnergyLLC_Adams)
end)

asset.export(BAT390_NeptuneEnergyCenterLLC_NeptuneEnergyCenterHybrid_Pueblo)
asset.export(BAT394_ThunderWolfEnergyCenterLLC_ThunderWolfEnergyCenterHybrid_Pueblo)
asset.export(BAT459_UnitedPowerInc_RattlesnakeRidgeBatteryStorage_Weld)
asset.export(BAT463_UnitedPowerInc_DavisBatteryStorage_Weld)
asset.export(BAT464_UnitedPowerInc_BromleyBatteryStorage_Adams)
asset.export(BAT465_UnitedPowerInc_KeenesburgBatteryStorage_Weld)
asset.export(BAT467_AESCleanEnergy_HighMesaCO_Garfield)
asset.export(BAT480_WhetstonePowerOperationsLLC_PrairieCenterEnergyLLC_Adams)

asset.export("showSeals", function (interpolationDuration)
  openspace.setPropertyValue("Scene.BAT*.Renderable.Opacity", 1, interpolationDuration)
end)

asset.export("hideSeals", function (interpolationDuration)
  openspace.setPropertyValue("Scene.BAT*.Renderable.Opacity", 0, interpolationDuration)
end)
