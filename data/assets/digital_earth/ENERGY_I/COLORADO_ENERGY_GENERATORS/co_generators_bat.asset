-- Colorado Energy Generators: Gas seals at their locations on Earth.
-- The seals are invisible by default, but can be enabled using shown or hidden using
-- the exported functions `showSeals(interpolationDuration)` and `hideSeals(interpolationDuration)`.

local earth = asset.require("scene/solarsystem/planets/earth/globe")

local BAT390_NeptuneEnergyCenterLLC_NeptuneEnergyCenterHybrid_Pueblo = {
  Identifier = "BAT390_NeptuneEnergyCenterLLC_NeptuneEnergyCenterHybrid_Pueblo",
  Parent = earth.Earth.Identifier,
  Transform = {
    Translation = {
      Type = "GlobeTranslation",
      Globe = earth.Earth.Identifier,
      Latitude = 38.330263,
      Longitude = -104.4142,
      Altitude = 4500,
      UseHeightmap = false
    }
  },
  Renderable = {
    Type = "RenderablePlaneImageLocal",
    Size = 5000,
    Origin = "Center",
    Billboard = true,
    Texture = openspace.absPath("${ASSETS}/digital_earth/ENERGY_I/COLORADO_ENERGY_GENERATORS/battery_pixel.perfect_flaticon.com.png"),
    Opacity = 1.0,
    Enabled = false,
  },
  GUI = {
    Path = "/CO Energy/BAT",
    Name = "BAT390 - Neptune Energy Center LLC, Neptune Energy Center Hybrid, Pueblo"
  }
}

