local ShowSeals = {
  Identifier = "os.HYD.ShowSeals",
  Name = "Show HYD landing labels",
  Command = [[openspace.setPropertyValue("Scene.HYD*.Renderable.Opacity", 1, 0.5)]],
  Documentation = "Show CO HYD seals.",
  GuiPath = "/DMNS/CO Energy",
  IsLocal = false
}

local HideSeals = {
  Identifier = "os.HYD.HideSeals",
  Name = "Hide HYD landing labels",
  Command = [[openspace.setPropertyValue("Scene.HYD*.Renderable.Opacity", 0, 0.5)]],
  Documentation = "Hide CO HYD seals",
  GuiPath = "/DMNS/CO Energy",
  IsLocal = false
}

asset.onInitialize(function()
  openspace.addSceneGraphNode(HYD008_PublicServiceCoofColorado_CabinCreek_ClearCreek)
  openspace.addSceneGraphNode(HYD057_USBureauofReclamation_BlueMesa_Gunnison)
  openspace.addSceneGraphNode(HYD059_USBureauofReclamation_Estes_Larimer)
  openspace.addSceneGraphNode(HYD062_USBureauofReclamation_MorrowPoint_Montrose)
  openspace.addSceneGraphNode(HYD065_USBureauofReclamation_GreenMountain_Summit)
  openspace.addSceneGraphNode(HYD068_USBureauofReclamation_Flatiron_Larimer)
  openspace.addSceneGraphNode(HYD071_USBureauofReclamation_PoleHill_Larimer)
  openspace.addSceneGraphNode(HYD085_USBureauofReclamation_Crystal_Montrose)
  openspace.addSceneGraphNode(HYD089_USBureauofReclamation_MountElbert_Lake)
  openspace.addSceneGraphNode(HYD105_CityofColoradoSpringsCO_Tesla_ElPaso)
  openspace.addSceneGraphNode(HYD107_USBureauofReclamation_Towaoc_Montezuma)
  openspace.action.registerAction(ShowSeals)
  openspace.action.registerAction(HideSeals)
end)

asset.onDeinitialize(function()
  openspace.action.removeAction(HideSeals)
  openspace.action.removeAction(ShowSeals)
  openspace.removeSceneGraphNode(HYD008_PublicServiceCoofColorado_CabinCreek_ClearCreek)
  openspace.removeSceneGraphNode(HYD057_USBureauofReclamation_BlueMesa_Gunnison)
  openspace.removeSceneGraphNode(HYD059_USBureauofReclamation_Estes_Larimer)
  openspace.removeSceneGraphNode(HYD062_USBureauofReclamation_MorrowPoint_Montrose)
  openspace.removeSceneGraphNode(HYD065_USBureauofReclamation_GreenMountain_Summit)
  openspace.removeSceneGraphNode(HYD068_USBureauofReclamation_Flatiron_Larimer)
  openspace.removeSceneGraphNode(HYD071_USBureauofReclamation_PoleHill_Larimer)
  openspace.removeSceneGraphNode(HYD085_USBureauofReclamation_Crystal_Montrose)
  openspace.removeSceneGraphNode(HYD089_USBureauofReclamation_MountElbert_Lake)
  openspace.removeSceneGraphNode(HYD105_CityofColoradoSpringsCO_Tesla_ElPaso)
  openspace.removeSceneGraphNode(HYD107_USBureauofReclamation_Towaoc_Montezuma)
end)

asset.export(HYD008_PublicServiceCoofColorado_CabinCreek_ClearCreek)
asset.export(HYD057_USBureauofReclamation_BlueMesa_Gunnison)
asset.export(HYD059_USBureauofReclamation_Estes_Larimer)
asset.export(HYD062_USBureauofReclamation_MorrowPoint_Montrose)
asset.export(HYD065_USBureauofReclamation_GreenMountain_Summit)
asset.export(HYD068_USBureauofReclamation_Flatiron_Larimer)
asset.export(HYD071_USBureauofReclamation_PoleHill_Larimer)
asset.export(HYD085_USBureauofReclamation_Crystal_Montrose)
asset.export(HYD089_USBureauofReclamation_MountElbert_Lake)
asset.export(HYD105_CityofColoradoSpringsCO_Tesla_ElPaso)
asset.export(HYD107_USBureauofReclamation_Towaoc_Montezuma)

asset.export("showSeals", function (interpolationDuration)
  openspace.setPropertyValue("Scene.HYD*.Renderable.Opacity", 1, interpolationDuration)
end)

asset.export("hideSeals", function (interpolationDuration)
  openspace.setPropertyValue("Scene.HYD*.Renderable.Opacity", 0, interpolationDuration)
end)
