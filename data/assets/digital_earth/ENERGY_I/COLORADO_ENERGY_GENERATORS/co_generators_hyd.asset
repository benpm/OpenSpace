-- Colorado Energy Generators: Hydropower seals at their locations on Earth.
-- The seals are invisible by default, but can be enabled using shown or hidden using
-- the exported functions `showSeals(interpolationDuration)` and `hideSeals(interpolationDuration)`.

local earth = asset.require("scene/solarsystem/planets/earth/globe")

local HYD008_PublicServiceCoofColorado_CabinCreek_ClearCreek = {
  Identifier = "HYD008_PublicServiceCoofColorado_CabinCreek_ClearCreek",
  Parent = earth.Earth.Identifier,
  Transform = {
    Translation = {
      Type = "GlobeTranslation",
      Globe = earth.Earth.Identifier,
      Latitude = 39.6551,
      Longitude = -105.7088,
      Altitude = 4500,
      UseHeightmap = false
    }
  },
  Renderable = {
    Type = "RenderablePlaneImageLocal",
    Size = 5000,
    Origin = "Center",
    Billboard = true,
    Texture = openspace.absPath("${ASSETS}/digital_earth/ENERGY_I/COLORADO_ENERGY_GENERATORS/hydro-power_cocoa.bella_flaticon.com_edit3.png"),
    Opacity = 1.0,
    Enabled = false,
  },
  GUI = {
    Path = "/CO Energy/HYD",
    Name = "HYD008 - Public Service Co of Colorado, Cabin Creek, Clear Creek"
  }
}

