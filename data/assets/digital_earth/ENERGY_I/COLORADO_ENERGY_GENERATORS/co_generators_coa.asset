local ShowSeals = {
  Identifier = "os.COA.ShowSeals",
  Name = "Show COA landing labels",
  Command = [[openspace.setPropertyValue("Scene.COA*.Renderable.Opacity", 1, 0.5)]],
  Documentation = "Show CO COA seals.",
  GuiPath = "/DMNS/CO Energy",
  IsLocal = false
}

local HideSeals = {
  Identifier = "os.COA.HideSeals",
  Name = "Hide COA landing labels",
  Command = [[openspace.setPropertyValue("Scene.COA*.Renderable.Opacity", 0, 0.5)]],
  Documentation = "Hide CO COA seals",
  GuiPath = "/DMNS/CO Energy",
  IsLocal = false
}

asset.onInitialize(function()
  openspace.addSceneGraphNode(COA014_PublicServiceCoofColorado_ComancheCO_Pueblo)
  openspace.addSceneGraphNode(COA074_PublicServiceCoofColorado_Hayden_Routt)
  openspace.addSceneGraphNode(COA076_TriStateGTAssnInc_CraigCO_Moffat)
  openspace.addSceneGraphNode(COA091_PublicServiceCoofColorado_Pawnee_Morgan)
  openspace.addSceneGraphNode(COA099_PlatteRiverPowerAuthority_Rawhide_Larimer)
  openspace.addSceneGraphNode(COA119_CityofColoradoSpringsCO_RayDNixon_ElPaso)
  openspace.action.registerAction(ShowSeals)
  openspace.action.registerAction(HideSeals)
end)

asset.onDeinitialize(function()
  openspace.action.removeAction(HideSeals)
  openspace.action.removeAction(ShowSeals)
  openspace.removeSceneGraphNode(COA014_PublicServiceCoofColorado_ComancheCO_Pueblo)
  openspace.removeSceneGraphNode(COA074_PublicServiceCoofColorado_Hayden_Routt)
  openspace.removeSceneGraphNode(COA076_TriStateGTAssnInc_CraigCO_Moffat)
  openspace.removeSceneGraphNode(COA091_PublicServiceCoofColorado_Pawnee_Morgan)
  openspace.removeSceneGraphNode(COA099_PlatteRiverPowerAuthority_Rawhide_Larimer)
  openspace.removeSceneGraphNode(COA119_CityofColoradoSpringsCO_RayDNixon_ElPaso)
end)

asset.export(COA014_PublicServiceCoofColorado_ComancheCO_Pueblo)
asset.export(COA074_PublicServiceCoofColorado_Hayden_Routt)
asset.export(COA076_TriStateGTAssnInc_CraigCO_Moffat)
asset.export(COA091_PublicServiceCoofColorado_Pawnee_Morgan)
asset.export(COA099_PlatteRiverPowerAuthority_Rawhide_Larimer)
asset.export(COA119_CityofColoradoSpringsCO_RayDNixon_ElPaso)

asset.export("showSeals", function (interpolationDuration)
  openspace.setPropertyValue("Scene.COA*.Renderable.Opacity", 1, interpolationDuration)
end)

asset.export("hideSeals", function (interpolationDuration)
  openspace.setPropertyValue("Scene.COA*.Renderable.Opacity", 0, interpolationDuration)
end)
