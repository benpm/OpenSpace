-- Colorado Energy Generators: Coal seals at their locations on Earth.
-- The seals are invisible by default, but can be enabled using shown or hidden using
-- the exported functions `showSeals(interpolationDuration)` and `hideSeals(interpolationDuration)`.

local earth = asset.require("scene/solarsystem/planets/earth/globe")

local COA014_PublicServiceCoofColorado_ComancheCO_Pueblo = {
  Identifier = "COA014_PublicServiceCoofColorado_ComancheCO_Pueblo",
  Parent = earth.Earth.Identifier,
  Transform = {
    Translation = {
      Type = "GlobeTranslation",
      Globe = earth.Earth.Identifier,
      Latitude = 38.2081,
      Longitude = -104.5747,
      Altitude = 4500,
      UseHeightmap = false
    }
  },
  Renderable = {
    Type = "RenderablePlaneImageLocal",
    Size = 5000,
    Origin = "Center",
    Billboard = true,
    Texture = openspace.absPath("${ASSETS}/digital_earth/ENERGY_I/COLORADO_ENERGY_GENERATORS/coal-power-plant_altop7_flaticon.com_edit.png"),
    Opacity = 1.0,
    Enabled = false,
  },
  GUI = {
    Path = "/CO Energy/COA",
    Name = "COA014 - Public Service Co of Colorado, Comanche CO, Pueblo"
  }
}

