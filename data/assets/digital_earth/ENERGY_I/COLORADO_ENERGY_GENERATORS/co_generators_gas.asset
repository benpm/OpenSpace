-- Colorado Energy Generators: Gas seals at their locations on Earth.
-- The seals are invisible by default, but can be enabled using shown or hidden using
-- the exported functions `showSeals(interpolationDuration)` and `hideSeals(interpolationDuration)`.

local earth = asset.require("scene/solarsystem/planets/earth/globe")

local GAS005_PublicServiceCoofColorado_Alamosa_Alamosa = {
  Identifier = "GAS005_PublicServiceCoofColorado_Alamosa_Alamosa",
  Parent = earth.Earth.Identifier,
  Transform = {
    Translation = {
      Type = "GlobeTranslation",
      Globe = earth.Earth.Identifier,
      Latitude = 37.4594,
      Longitude = -105.8947,
      Altitude = 4500,
      UseHeightmap = false
    }
  },
  Renderable = {
    Type = "RenderablePlaneImageLocal",
    Size = 5000,
    Origin = "Center",
    Billboard = true,
    Texture = openspace.absPath("${ASSETS}/digital_earth/ENERGY_I/COLORADO_ENERGY_GENERATORS/natural-gas_freepik_flaticon.com_edit.png"),
    Opacity = 1.0,
    Enabled = false,
  },
  GUI = {
    Path = "/CO Energy/GAS",
    Name = "GAS005 - Public Service Co of Colorado, Alamosa, Alamosa"
  }
}

