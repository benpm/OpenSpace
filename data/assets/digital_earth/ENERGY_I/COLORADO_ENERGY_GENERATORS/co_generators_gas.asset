local ShowSeals = {
  Identifier = "os.GAS.ShowSeals",
  Name = "Show GAS landing labels",
  Command = [[openspace.setPropertyValue("Scene.GAS*.Renderable.Opacity", 1, 0.5)]],
  Documentation = "Show CO GAS seals.",
  GuiPath = "/DMNS/CO Energy",
  IsLocal = false
}

local HideSeals = {
  Identifier = "os.GAS.HideSeals",
  Name = "Hide GAS landing labels",
  Command = [[openspace.setPropertyValue("Scene.GAS*.Renderable.Opacity", 0, 0.5)]],
  Documentation = "Hide CO GAS seals",
  GuiPath = "/DMNS/CO Energy",
  IsLocal = false
}

asset.onInitialize(function()
  openspace.addSceneGraphNode(GAS005_PublicServiceCoofColorado_Alamosa_Alamosa)
  openspace.addSceneGraphNode(GAS010_PublicServiceCoofColorado_Cherokee_Adams)
