-- Nantucket, MA
-- New Bedford, MA
-- New London, CT
-- Provincetown, MA
-- Sag Harbor, NY
-- San Francisco, CA

local NantucketMA = {
  Identifier = "WhalingPortNantucketMASeal",
  Parent = earth.Earth.Identifier,
  Transform = {
    Translation = {
      Type = "GlobeTranslation",
      Globe = earth.Earth.Identifier,
      Latitude = 41.25986196642714,
      Longitude = -70.0401494805066,
      Altitude = 11000,
      UseHeightmap = false
    }
  },
  Renderable = {
    Type = "RenderablePlaneImageLocal",
    Size = 17410,
    Origin = "Center",
    Billboard = true,
    Texture = openspace.absPath("${ASSETS}/digital_earth/ENERGY_I/whaling_ports/nantucket_ma.png"),
    Opacity = 1.0
  },
  GUI = {
    Path = "/Earth Layers/Whaling Ports",
    Name = "Nantucket MA Seal"
  }
}

