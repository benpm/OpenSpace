local ShowSeals = {
  Identifier = "os.WhalingPorts.ShowSeals",
  Name = "Show Whaling Port landing labels",
  Command = [[openspace.setPropertyValue("Scene.WhalingPort*Seal.Renderable.Opacity", 1, 0.5)]],
  Documentation = "Show whaling port seals.",
  GuiPath = "/DMNS/Whaling Ports",
  IsLocal = false
}

local HideSeals = {
  Identifier = "os.WhalingPorts.HideSeals",
  Name = "Hide Whaling Port landing labels",
  Command = [[openspace.setPropertyValue("Scene.WhalingPort*Seal.Renderable.Opacity", 0, 0.5)]],
  Documentation = "Hide whaling port seals",
  GuiPath = "/DMNS/Whaling Ports",
  IsLocal = false
}

asset.onInitialize(function()
  openspace.addSceneGraphNode(NantucketMA)
  openspace.addSceneGraphNode(NewBedfordMA)
  openspace.addSceneGraphNode(NewLondonCT)
  openspace.addSceneGraphNode(ProvincetownMA)
  openspace.addSceneGraphNode(SagHarborNY)
  openspace.addSceneGraphNode(SanFranciscoCA)
  openspace.action.registerAction(ShowSeals)
  openspace.action.registerAction(HideSeals)
end)

asset.onDeinitialize(function()
  openspace.action.removeAction(HideSeals)
  openspace.action.removeAction(ShowSeals)
  openspace.removeSceneGraphNode(NantucketMA)
  openspace.removeSceneGraphNode(NewBedfordMA)
  openspace.removeSceneGraphNode(NewLondonCT)
  openspace.removeSceneGraphNode(ProvincetownMA)
  openspace.removeSceneGraphNode(SagHarborNY)
  openspace.removeSceneGraphNode(SanFranciscoCA)
end)

asset.export(NantucketMA)
asset.export(NewBedfordMA)
asset.export(NewLondonCT)
asset.export(ProvincetownMA)
asset.export(SagHarborNY)
asset.export(SanFranciscoCA)

-- asset.export("showSeal", function (missionNumber, interpolationDuration)
--   openspace.setPropertyValue("Scene.WhalingPorts" .. missionNumber .. "Seal.Renderable.Opacity", 1, interpolationDuration)
-- end)
-- asset.export("hideSeal", function (missionNumber, interpolationDuration)
--   openspace.setPropertyValue("Scene.WhalingPorts" .. missionNumber .. "Seal.Renderable.Opacity", 0, interpolationDuration)
-- end)

asset.export("showSeals", function (interpolationDuration)
  openspace.setPropertyValue("Scene.WhalingPorts*Seal.Renderable.Opacity", 1, interpolationDuration)
end)

asset.export("hideSeals", function (interpolationDuration)
  openspace.setPropertyValue("Scene.WhalingPorts*Seal.Renderable.Opacity", 0, interpolationDuration)
end)
