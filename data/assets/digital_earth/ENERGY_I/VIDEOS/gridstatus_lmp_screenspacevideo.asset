-- http://wiki.openspaceproject.com/docs/builders/assets/resources.html

local ScreenSpace = {
  Identifier = "GridStatus_LMP_Animation_2025-08-15",
  Type = "ScreenSpaceVideo",
  Name = "GridStatus LMP Animation 2025-08-15",
  Video = asset.resource("gridstatus_LMP_2025.08.15.mp4")
}

asset.onInitialize(function()
  openspace.addScreenSpaceRenderable(ScreenSpace)
end)

asset.onDeinitialize(function()
  openspace.removeScreenSpaceRenderable(ScreenSpace)
end)

asset.export(ScreenSpace)

asset.meta = {
  Name = "GridStatus_LMP_Animation_2025-08-15",
  Version = "1.0",
  Description = "",
  Author = "OpenSpace Team",
  URL = "https://openspaceproject.com",
  License = "MIT"
}
