local earth = asset.require("scene/solarsystem/planets/earth/globe")

local blackMarbleSphere = {
	Identifier = "blackMarble2016_01deg",
	Parent = earth.Earth.Identifier,
	Transform = {
		Rotation = {
			Type = "StaticRotation",
			Rotation = {0.000000,0.000000,3.141592653590}
		}
	},
	Renderable = {
		Type = "RenderableSphereImageLocal",
		Size = 6615000.0, -- Render above the Earth sphere
		Enabled = false,
		Texture = openspace.absPath("${ASSETS}/digital_earth/ENERGY_I/EARTH_AT_NIGHT/blackmarble_2016_01deg.jpg")
	},
	GUI = {
		Name = "Black Marble 2016 - 01deg",
		Path = "/Earth Layers/Black Marble"
	}
}

asset.onInitialize(function()
  openspace.addSceneGraphNode(blackMarbleSphere)
end)

asset.onDeinitialize(function()
  openspace.removeSceneGraphNode(blackMarbleSphere)
end)

asset.meta = {
  Name = "Earth At Night",
  Description = "",
  Author = "Ka Chun Yu",
  URL = "https://openspaceproject.com",
  License = "MIT"
}
